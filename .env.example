# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheduling_db?schema=public"

# Google Gemini API
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Chave de Criptografia Simétrica (AES-256-GCM)
# Deve ser uma string hexadecimal de 64 caracteres (32 bytes) para produção
ENCRYPTION_KEY="sua_chave_de_criptografia_de_32_bytes_aqui"

# Integração Evolution API (WhatsApp)
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="sua_api_key_evolution_aqui"
EVOLUTION_INSTANCE_NAME="psicologa"

# Google Calendar (OAuth ou Service Account)
GOOGLE_CLIENT_ID="seu_client_id_google_aqui"
GOOGLE_CLIENT_SECRET="seu_client_secret_google_aqui"
GOOGLE_REDIRECT_URI="http://localhost:3000/oauth2callback"
GOOGLE_REFRESH_TOKEN="seu_refresh_token_google_aqui"
GOOGLE_CALENDAR_ID="primary"
